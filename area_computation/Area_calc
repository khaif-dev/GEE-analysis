// get kiambu and thika districts from fao gaul dataset
var province = 'Central'
var district = 'Thika'
var district2 = 'Kiambu'

var roi = admn2
  .filter(ee.Filter.eq('ADM1_NAME', province))
  .filter(ee.Filter.inList('ADM2_NAME', [district, district2]))
  // .filter(ee.Filter.eq('ADM2_NAME', district2));
